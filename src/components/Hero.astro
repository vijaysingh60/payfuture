---
import Icon from './Icon.astro';
import { hero, heroPills, heroSlides, trust } from '../data/home';

// Each headline pill cycles through its own crops, starting on a different one.
const first = heroSlides[0];

// Trust logos are repeated so each half of the marquee is wider than the screen.
const logoSet = [...trust.logos, ...trust.logos];
---

<section class="hero" id="top" data-hero>
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true" data-hero-glow></div>
  <svg class="hero__rails" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g class="rails-base">
      <path d="M-60 700 C 300 560, 520 780, 1500 380"></path>
      <path d="M-60 180 C 380 340, 760 20, 1500 220"></path>
      <path d="M-60 460 C 420 260, 900 620, 1500 600"></path>
    </g>
    <g class="rails-pulse">
      <path pathLength="1000" d="M-60 700 C 300 560, 520 780, 1500 380"></path>
      <path pathLength="1000" d="M-60 180 C 380 340, 760 20, 1500 220"></path>
      <path pathLength="1000" d="M-60 460 C 420 260, 900 620, 1500 600"></path>
    </g>
  </svg>

  <div class="container hero__inner">
    <a class="announce" href="#corridors" data-hero-fade>
      <span class="announce__dot"></span>
      {hero.eyebrow}
      <Icon name="arrow" size={15} />
    </a>

    <h1 class="hero__title" aria-label="Fiat or stablecoin in. Local currency out.">
      <span class="hero__line" aria-hidden="true">
        <span class="mask"><span data-hero-word>Fiat</span></span>
        <span class="mask"><span data-hero-word>or</span></span>
        <span class="photo-pill" data-pill>
          {heroPills.a.map((src) => <img src={src} alt="" />)}
        </span>
        <span class="mask"><span data-hero-word>stablecoin</span></span>
        <span class="mask"><span data-hero-word>in.</span></span>
      </span>
      <span class="hero__line" aria-hidden="true">
        <span class="mask"><span class="accent" data-hero-word>Local</span></span>
        <span class="mask"><span class="accent" data-hero-word>currency</span></span>
        <span class="photo-pill" data-pill>
          {heroPills.b.map((src) => <img src={src} alt="" />)}
        </span>
        <span class="mask"><span class="accent" data-hero-word>out.</span></span>
      </span>
    </h1>

    <p class="hero__text" data-hero-fade>{hero.text}</p>

    <div class="hero__actions" data-hero-fade>
      <a class="btn btn--lg" href="#contact" data-magnetic>
        Get started
        <span class="btn__arrow"><Icon name="arrow" size={16} /></span>
      </a>
      <a class="link-arrow link-arrow--light" href="#corridors">
        Explore our corridors
        <Icon name="arrow" size={16} />
      </a>
    </div>
  </div>

  <div class="stage" data-stage>
    <div class="stage__frame" data-stage-frame>
      {
        heroSlides.map((slide, i) => (
          <div class="stage__slide" data-slide-title={slide.chip.title} data-slide-sub={slide.chip.sub}>
            <img src={slide.src} alt={slide.alt} loading={i === 0 ? 'eager' : 'lazy'} width="1269" height="777" />
          </div>
        ))
      }
      <div class="stage__shade" aria-hidden="true"></div>

      <div class="chip chip--approved" aria-hidden="true">
        <span class="chip__icon"><Icon name="check" size={18} /></span>
        <span>
          <strong data-chip-title>{first.chip.title}</strong>
          <small data-chip-sub>{first.chip.sub}</small>
        </span>
      </div>
      <div class="chip chip--methods" aria-hidden="true">
        <span class="chip__flags">
          <img src="/img/flags/india.svg" alt="" />
          <img src="/img/flags/pakistan.svg" alt="" />
          <img src="/img/flags/nigeria.svg" alt="" />
          <img src="/img/flags/philippines.png" alt="" />
          <img src="/img/flags/egypt.svg" alt="" />
        </span>
        <span>
          <strong>Fiat or stablecoin in</strong>
          <small>Local currency out</small>
        </span>
      </div>

      <div class="stage__dots" role="tablist" aria-label="Hero images">
        {
          heroSlides.map((_, i) => (
            <button
              class={`stage__dot${i === 0 ? ' is-active' : ''}`}
              type="button"
              role="tab"
              aria-label={`Show image ${i + 1}`}
              aria-selected={i === 0 ? 'true' : 'false'}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<section class="trust">
  <p class="trust__title" data-reveal>{trust.title}</p>
  <div class="marquee" data-reveal>
    <div class="marquee__track">
      {
        [0, 1].map((set) =>
          logoSet.map((logo, i) => {
            // Only the first copy of each logo is announced to screen readers.
            const first = set === 0 && i < trust.logos.length;
            return (
              <div class="marquee__item" aria-hidden={first ? undefined : 'true'}>
                <img src={logo.src} alt={first ? logo.name : ''} loading="lazy" />
              </div>
            );
          }),
        )
      }
    </div>
  </div>
</section>
