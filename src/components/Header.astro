---
import Icon from './Icon.astro';
import { nav } from '../data/home';
---

<div class="loader" data-loader aria-hidden="true">
  <img src="/img/logo.svg" alt="" width="190" height="50" />
  <span class="loader__bar"></span>
</div>

<div class="progress" aria-hidden="true"></div>

<header class="header" data-header>
  <div class="header__bar">
    <a class="header__logo" href="#top" aria-label="Payfuture home">
      <img src="/img/logo.svg" alt="Payfuture" width="158" height="42" />
    </a>

    <nav class="nav" aria-label="Main" data-nav>
      <ul class="nav__list">
        {
          nav.map((item) => (
            <li class="nav__item">
              <a class="nav__link" href={item.href}>
                {item.label}
                <Icon name="down" size={15} />
              </a>
              <div class={`nav__panel${item.links.length > 8 ? ' nav__panel--wide' : ''}`}>
                <ul>
                  {item.links.map((link) => (
                    <li>
                      <a href={item.href}>{link}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--sm" href="#contact">Contact sales</a>
    </nav>

    <button class="header__toggle" type="button" aria-label="Toggle menu" aria-expanded="false" data-nav-toggle>
      <Icon name="menu" size={24} class="icon-open" />
      <Icon name="close" size={24} class="icon-close" />
    </button>
  </div>
</header>
