---
import Icon from './Icon.astro';
import { industries, partners, stats, highlights } from '../data/home';
---

<section class="section industries" id="industries">
  <div class="container">
    <header class="section__head section__head--left">
      <h2 class="display display--dark" data-split>Businesses we empower</h2>
      <p class="lead" data-reveal>
        We support businesses across e-commerce, platforms, travel, and regulated industries that require reliable
        online and international payment solutions like payment processing and payment gateways.
      </p>
    </header>

    <ul class="rows" data-rows>
      {
        industries.map((item, i) => (
          <li data-reveal>
            <a class="row" href="#industries" data-row={item.img}>
              <span class="row__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="row__name">{item.name}</span>
              <img class="row__thumb" src={item.img} alt="" loading="lazy" />
              <span class="row__arrow"><Icon name="arrow" size={20} /></span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="rows__float" data-rows-float aria-hidden="true"><img src={industries[0].img} alt="" /></div>

    <p class="partners__title" data-reveal>
      We collaborate with industry partners to extend our reach and enhance payment solutions
    </p>
    <ul class="partners">
      {
        partners.map((p) => (
          <li data-reveal>
            <img src={p.icon} alt="" width="40" height="40" loading="lazy" />
            {p.name}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="stats-section">
  <div class="container">
    <header class="section__head">
      <h2 class="display display--dark" data-split>Turn complex markets into growth opportunities</h2>
      <p class="lead" data-reveal>
        Our payment solution connects you to popular payment options in each region. Leverage our local expertise to
        enter emerging markets with the most popular payment methods
      </p>
    </header>

    <ul class="stats">
      {
        stats.map((s) => (
          <li data-reveal>
            <strong>
              <span data-count={s.value} data-decimals={s.decimals}>{s.value}</span>{s.suffix}
            </strong>
            <span>{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="ticker" aria-label="Platform highlights">
    <div class="ticker__track">
      {
        [0, 1, 2].map((set) =>
          highlights.map((h) => (
            <span class="ticker__item" aria-hidden={set > 0 ? 'true' : undefined}>
              <i></i>
              {h}
            </span>
          )),
        )
      }
    </div>
  </div>
</section>
