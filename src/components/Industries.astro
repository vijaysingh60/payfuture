---
import Icon from './Icon.astro';
import { who, growth } from '../data/home';
---

<section class="section industries" id="who-we-work-with">
  <div class="container">
    <header class="section__head section__head--left">
      <h2 class="display display--dark" data-split>{who.title}</h2>
      <p class="lead" data-reveal>{who.text}</p>
    </header>

    <ul class="rows" data-rows>
      {
        who.items.map((item, i) => (
          <li data-reveal>
            <a class="row" href="#who-we-work-with" data-row={item.img}>
              <span class="row__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="row__name">{item.name}</span>
              <img class="row__thumb" src={item.img} alt="" loading="lazy" />
              <span class="row__arrow"><Icon name="arrow" size={20} /></span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="rows__float" data-rows-float aria-hidden="true"><img src={who.items[0].img} alt="" /></div>

    <p class="partners__title" data-reveal>{who.partnersTitle}</p>
    <ul class="partners partners--two">
      {
        who.partners.map((p) => (
          <li data-reveal>
            <img src={p.icon} alt="" width="40" height="40" loading="lazy" />
            {p.name}
            <span class="partners__arrow"><Icon name="arrow" size={18} /></span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="stats-section">
  <div class="container">
    <header class="section__head">
      <h2 class="display display--dark" data-split>{growth.title}</h2>
      <p class="lead" data-reveal>{growth.text}</p>
    </header>

    <ul class="stats">
      {
        growth.stats.map((s) => (
          <li data-reveal>
            <strong>
              <span data-count={s.value} data-decimals={s.decimals}>{s.value}</span>{s.suffix}
            </strong>
            <span>{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="ticker" aria-label="Payfuture solutions">
    <div class="ticker__track">
      {
        [0, 1, 2].map((set) =>
          growth.ticker.map((h) => (
            <span class="ticker__item" aria-hidden={set > 0 ? 'true' : undefined}>
              <i></i>
              {h}
            </span>
          )),
        )
      }
    </div>
  </div>
</section>
