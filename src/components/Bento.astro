---
import Icon from './Icon.astro';
import { features, corridors } from '../data/home';
import { routes } from '../data/site';

const [lastMile, inOut, rails, partner] = features;
const steps = ['Funds received', 'Screened', 'Converted', 'Recipient paid'];
---

<section class="section bento-section">
  <div class="container bento">
    <article class="tile tile--dark tile--wide" data-reveal>
      <div class="tile__body">
        <span class="icon-tile icon-tile--yellow"><Icon name={lastMile.icon} size={22} /></span>
        <h3>{lastMile.title}</h3>
        <p>{lastMile.text}</p>
        <a class="link-arrow link-arrow--light" href="#corridors">Learn more <Icon name="arrow" size={16} /></a>
      </div>
      <div class="orbit" aria-hidden="true">
        <span class="orbit__core"><img src="/img/favicon.png" alt="" /></span>
        <div class="orbit__ring orbit__ring--inner">
          {
            corridors.map((m, i) => (
              <span class="orbit__coin" style={`--a:${(360 / corridors.length) * i}deg`}>
                <span><img src={m.flag} alt="" /></span>
              </span>
            ))
          }
        </div>
        <div class="orbit__ring orbit__ring--outer">
          {
            corridors.map((m, i) => (
              <span class="orbit__coin orbit__coin--code" style={`--a:${(360 / corridors.length) * i + 36}deg`}>
                <span><b>{m.currency}</b></span>
              </span>
            ))
          }
        </div>
      </div>
    </article>

    <article class="tile tile--narrow" data-reveal>
      <div class="tile__body">
        <span class="icon-tile"><Icon name={inOut.icon} size={22} /></span>
        <h3>{inOut.title}</h3>
        <p>{inOut.text}</p>
      </div>
      <div class="ledger" aria-hidden="true" data-inview>
        <div class="ledger__row ledger__row--in">
          <span class="ledger__dir"><Icon name="arrowIn" size={14} /> In</span>
          <span>Remittance</span>
          <b>INR</b>
        </div>
        <div class="ledger__row ledger__row--in">
          <span class="ledger__dir"><Icon name="arrowIn" size={14} /> In</span>
          <span>Buyer payment</span>
          <b>PKR</b>
        </div>
        <div class="ledger__row ledger__row--out">
          <span class="ledger__dir"><Icon name="arrowOut" size={14} /> Out</span>
          <span>Supplier payment</span>
          <b>Abroad</b>
        </div>
        <div class="ledger__row ledger__row--in">
          <span class="ledger__dir"><Icon name="arrowIn" size={14} /> In</span>
          <span>Remittance</span>
          <b>NGN</b>
        </div>
      </div>
      <a class="link-arrow" href="#money-in-out">Learn more <Icon name="arrow" size={16} /></a>
    </article>

    <article class="tile tile--yellow tile--narrow" data-reveal>
      <div class="tile__body">
        <span class="icon-tile"><Icon name={rails.icon} size={22} /></span>
        <h3>{rails.title}</h3>
        <p>{rails.text}</p>
      </div>
      <div class="rails-toggle" aria-hidden="true">
        <div class="rails-toggle__switch">
          <span class="rails-toggle__thumb"></span>
          <span>Fiat</span>
          <span>Stablecoin</span>
        </div>
        <span class="rails-toggle__arrow"><Icon name="arrowIn" size={18} /></span>
        <div class="rails-toggle__out">
          <span class="chip__flags">
            {corridors.map((m) => <img src={m.flag} alt="" />)}
          </span>
          Paid in local currency
        </div>
      </div>
      <a class="link-arrow" href={routes.stablecoin}>Learn more <Icon name="arrow" size={16} /></a>
    </article>

    <article class="tile tile--wide tile--support" data-reveal>
      <div class="tile__body">
        <span class="icon-tile"><Icon name={partner.icon} size={22} /></span>
        <h3>{partner.title}</h3>
        <p>{partner.text}</p>
        <a class="link-arrow" href={routes.about}>Learn more <Icon name="arrow" size={16} /></a>
      </div>
      <ol class="journey" aria-hidden="true">
        {
          steps.map((step, i) => (
            <li style={`--i:${i}`}>
              <span class="journey__dot">
                <Icon name="check" size={14} />
              </span>
              {step}
            </li>
          ))
        }
      </ol>
    </article>
  </div>
</section>
