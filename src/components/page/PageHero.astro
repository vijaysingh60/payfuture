---
import Icon from '../Icon.astro';

interface Chip {
  icon: string;
  title: string;
  sub: string;
}
interface Props {
  eyebrow?: string;
  /** Wrap words in *asterisks* to colour them yellow. */
  title: string;
  text: string;
  cta?: { label: string; href: string };
  secondary?: { label: string; href: string };
  image?: { src: string; alt: string };
  chips?: Chip[];
}
const { eyebrow, title, text, cta, secondary, image, chips = [] } = Astro.props;

// Split the title into words so each can rise out of its own mask.
let accent = false;
const words = title.split(' ').map((raw) => {
  const opens = raw.startsWith('*');
  const closes = raw.endsWith('*') || raw.endsWith('*.');
  if (opens) accent = true;
  const word = { text: raw.replace(/\*/g, ''), accent };
  if (closes) accent = false;
  return word;
});
const plainTitle = title.replace(/\*/g, '');
const hasMedia = Boolean(image) || Astro.slots.has('visual');
---

<section class={`ph${hasMedia ? '' : ' ph--solo'}`} data-page-hero data-glow-area>
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true" data-glow></div>
  <svg class="hero__rails" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g class="rails-base">
      <path d="M-60 760 C 300 620, 520 840, 1500 440"></path>
      <path d="M-60 260 C 380 420, 760 100, 1500 300"></path>
    </g>
    <g class="rails-pulse">
      <path pathLength="1000" d="M-60 760 C 300 620, 520 840, 1500 440"></path>
      <path pathLength="1000" d="M-60 260 C 380 420, 760 100, 1500 300"></path>
    </g>
  </svg>

  <div class="container ph__inner">
    <div class="ph__copy">
      {
        eyebrow && (
          <span class="announce announce--static" data-ph-fade>
            <span class="announce__dot" />
            {eyebrow}
          </span>
        )
      }
      <h1 class="ph__title" aria-label={plainTitle}>
        <span aria-hidden="true">
          {
            words.map((w) => (
              <>
                <span class="mask">
                  <span class={w.accent ? 'accent' : undefined} data-ph-word>
                    {w.text}
                  </span>
                </span>{' '}
              </>
            ))
          }
        </span>
      </h1>
      <p class="ph__text" data-ph-fade>{text}</p>
      {
        (cta || secondary) && (
          <div class="ph__actions" data-ph-fade>
            {cta && (
              <a class="btn btn--lg" href={cta.href} data-magnetic>
                {cta.label}
                <span class="btn__arrow">
                  <Icon name="arrow" size={16} />
                </span>
              </a>
            )}
            {secondary && (
              <a class="link-arrow link-arrow--light" href={secondary.href}>
                {secondary.label}
                <Icon name="arrow" size={16} />
              </a>
            )}
          </div>
        )
      }
    </div>

    {hasMedia && (
    <div class="ph__media" data-ph-media>
      {
        image ? (
          <div class="ph__frame">
            <img src={image.src} alt={image.alt} loading="eager" data-ph-img />
          </div>
        ) : (
          <slot name="visual" />
        )
      }
      {
        chips.map((chip, i) => (
          <div class={`chip ph__chip ph__chip--${i}`} aria-hidden="true" data-ph-chip>
            <span class="chip__icon">
              <Icon name={chip.icon} size={18} />
            </span>
            <span>
              <strong>{chip.title}</strong>
              <small>{chip.sub}</small>
            </span>
          </div>
        ))
      }
    </div>
    )}
  </div>
</section>
