---
import type { Stat } from '../../data/countries';

interface Props {
  items: Stat[];
  /** Dark cards for use on a dark panel. */
  dark?: boolean;
  big?: boolean;
}
const { items, dark = false, big = false } = Astro.props;
---

<ul class={`stats-cards${dark ? ' stats-cards--dark' : ''}${big ? ' stats-cards--big' : ''}`} style={`--n:${items.length}`}>
  {
    items.map((s) => (
      <li data-reveal data-tilt>
        <strong>
          {s.display ? (
            s.display
          ) : (
            <>
              {s.prefix}
              <span data-count={s.value} data-decimals={s.decimals ?? 0}>{s.value}</span>
              {s.suffix}
            </>
          )}
        </strong>
        <span class="stats-cards__label">{s.label}</span>
        {s.text && <p>{s.text}</p>}
      </li>
    ))
  }
</ul>
