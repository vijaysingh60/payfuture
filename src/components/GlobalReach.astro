---
import Icon from './Icon.astro';

interface Market {
  name: string;
  flag: string;
  currency?: string;
  lon: number;
  lat: number;
}
interface Props {
  id?: string;
  title: string;
  text: string;
  markets: Market[];
}
const { id = 'corridors', title, text, markets } = Astro.props;
---

<section class="reach" id={id}>
  <div class="container reach__inner">
    <div class="reach__copy">
      <h2 class="display" data-split>{title}</h2>
      <p class="lead" data-reveal>{text}</p>

      <label class="reach__search" data-reveal>
        <span class="sr-only">Search for a country</span>
        <Icon name="search" size={20} />
        <input type="search" placeholder="Search for a country" autocomplete="off" data-market-search />
      </label>

      <ul class="reach__grid" data-market-grid>
        {
          markets.map((m) => (
            <li data-reveal="scale">
              <a class="market" href={`#${id}`} data-market={m.name}>
                <img src={m.flag} alt="" width="26" height="26" loading="lazy" />
                <span class="market__name">{m.name}</span>
                {m.currency && <span class="market__code">{m.currency}</span>}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="reach__empty" data-market-empty hidden>No market matches that search yet.</p>
    </div>

    <div class="reach__visual" aria-hidden="true">
      <div class="reach__halo"></div>
      <canvas class="reach__globe" data-globe data-markets={JSON.stringify(markets)}></canvas>
    </div>
  </div>
</section>
