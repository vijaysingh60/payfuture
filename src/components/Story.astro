---
import Icon from './Icon.astro';
import { why, useCases, corridors } from '../data/home';
import { routes } from '../data/site';

const [payouts, rails, mass] = useCases.items;

// 01: one sender fanning out to the five corridors.
const fan = corridors.map((m, i) => ({ ...m, y: 42 + i * 64 }));

// 02: fiat or stablecoin in, local currency out.
const inputs = [
  { label: 'Fiat', y: 110 },
  { label: 'Stablecoin', y: 230 },
];

// 03: one run paying many people.
const people = Array.from({ length: 10 }, (_, i) => {
  const angle = (Math.PI * 2 * i) / 10 - Math.PI / 2;
  return { x: 210 + Math.cos(angle) * 165, y: 170 + Math.sin(angle) * 128 };
});
---

<section class="section why">
  <div class="container why__inner">
    <div class="why__copy">
      <span class="pill" data-reveal>{why.eyebrow}</span>
      <h2 class="display display--dark" data-split>{why.title}</h2>
      <p class="why__statement" data-highlight>{why.text}</p>
    </div>
    <div class="why__visual">
      <canvas data-lottie="/img/why.lottie" aria-label="Payfuture connecting merchants to local markets" role="img"
      ></canvas>
    </div>
  </div>
</section>

<section class="section section--soft flex-section" id="solutions">
  <div class="container">
    <header class="section__head">
      <h2 class="display display--dark" data-split>{useCases.title}</h2>
      <p class="lead" data-reveal>{useCases.text}</p>
    </header>

    <div class="stack" data-stack>
      <article class="stack__card" style="--i:0">
        <div class="stack__copy">
          <span class="stack__num">01</span>
          <h3>{payouts.title}</h3>
          <p>{payouts.text}</p>
          <a class="btn" href="#corridors"
            >{payouts.cta} <span class="btn__arrow"><Icon name="arrow" size={16} /></span></a
          >
        </div>
        <div class="stack__visual" aria-hidden="true">
          <svg class="diagram" viewBox="0 0 420 340">
            {fan.map((m) => <path class="diagram__link" d={`M120 170 C 190 170, 170 ${m.y}, 238 ${m.y}`} pathLength="100" />)}
            {
              fan.map((m) => (
                <g transform={`translate(238 ${m.y})`}>
                  <rect class="diagram__node" x="0" y="-21" width="176" height="42" rx="21" />
                  <image href={m.flag} x="10" y="-12" width="24" height="24" />
                  <text class="diagram__label diagram__label--start" x="42" y="5">{m.name}</text>
                  <text class="diagram__code" x="164" y="5">{m.currency}</text>
                </g>
              ))
            }
            <circle class="diagram__pulse" cx="70" cy="170" r="50"></circle>
            <circle class="diagram__hub" cx="70" cy="170" r="50"></circle>
            <image href="/img/favicon.png" x="48" y="148" width="44" height="44" class="diagram__mark"></image>
          </svg>
        </div>
      </article>

      <article class="stack__card stack__card--yellow" style="--i:1">
        <div class="stack__copy">
          <span class="stack__num">02</span>
          <h3>{rails.title}</h3>
          <p>{rails.text}</p>
          <a class="btn btn--dark" href={routes.stablecoin}
            >{rails.cta} <span class="btn__arrow"><Icon name="arrow" size={16} /></span></a
          >
        </div>
        <div class="stack__visual" aria-hidden="true">
          <svg class="diagram" viewBox="0 0 420 340">
            {inputs.map((n) => <path class="diagram__link" d={`M150 ${n.y} C 230 ${n.y}, 210 170, 290 170`} pathLength="100" />)}
            {
              inputs.map((n) => (
                <g transform={`translate(20 ${n.y})`}>
                  <rect class="diagram__node" x="0" y="-24" width="130" height="48" rx="24" />
                  <text class="diagram__label" x="65" y="5">{n.label}</text>
                </g>
              ))
            }
            <circle class="diagram__pulse" cx="340" cy="170" r="56"></circle>
            <circle class="diagram__hub" cx="340" cy="170" r="56"></circle>
            <text class="diagram__hub-label diagram__hub-label--sm" x="340" y="166">Local</text>
            <text class="diagram__hub-label diagram__hub-label--sm" x="340" y="185">currency</text>
          </svg>
        </div>
      </article>

      <article class="stack__card stack__card--dark" style="--i:2">
        <div class="stack__copy">
          <span class="stack__num">03</span>
          <h3>{mass.title}</h3>
          <p>{mass.text}</p>
          <a class="btn" href={routes.massPayments}
            >{mass.cta} <span class="btn__arrow"><Icon name="arrow" size={16} /></span></a
          >
        </div>
        <div class="stack__visual" aria-hidden="true">
          <svg class="diagram diagram--dark" viewBox="0 0 420 340">
            {people.map((p) => <line class="diagram__link" x1="210" y1="170" x2={p.x} y2={p.y} pathLength="100" />)}
            {
              people.map((p, i) => (
                <g transform={`translate(${p.x} ${p.y})`} class="diagram__person" style={`--i:${i}`}>
                  <circle r="20" />
                  <circle class="diagram__person-head" cy="-5" r="5" />
                  <path class="diagram__person-body" d="M-9 11 a9 8 0 0 1 18 0" />
                </g>
              ))
            }
            <circle class="diagram__pulse" cx="210" cy="170" r="50"></circle>
            <circle class="diagram__hub" cx="210" cy="170" r="50"></circle>
            <text class="diagram__hub-label diagram__hub-label--sm" x="210" y="166">One</text>
            <text class="diagram__hub-label diagram__hub-label--sm" x="210" y="185">run</text>
          </svg>
        </div>
      </article>
    </div>
  </div>
</section>
