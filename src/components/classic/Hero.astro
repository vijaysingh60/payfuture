---
import Icon from './Icon.astro';
import { heroSlides } from '../../data/home';
---

<section class="hero" id="top">
  <div class="hero__panel">
    <svg class="hero__rails" viewBox="0 0 960 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g class="rails-base">
        <path d="M-40 520 C 220 420, 420 560, 1000 300" />
        <path d="M-40 140 C 260 260, 520 20, 1000 160" />
        <path d="M-40 360 C 300 200, 620 460, 1000 440" />
        <path d="M180 -40 C 260 220, 560 340, 620 640" />
      </g>
      <g class="rails-pulse">
        <path pathLength="1000" d="M-40 520 C 220 420, 420 560, 1000 300" />
        <path pathLength="1000" d="M-40 140 C 260 260, 520 20, 1000 160" />
        <path pathLength="1000" d="M-40 360 C 300 200, 620 460, 1000 440" />
        <path pathLength="1000" d="M180 -40 C 260 220, 560 340, 620 640" />
      </g>
    </svg>

    <div class="hero__content">
      <h1 class="hero__title">
        <span class="line"><span data-hero-line>Reach billions in</span></span>
        <span class="line">
          <span data-hero-line>
            emerging markets
            <svg class="hero__underline" viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true">
              <path pathLength="1" d="M2 8 C 60 2, 130 2, 180 6 S 270 9, 298 4" />
            </svg>
          </span>
        </span>
      </h1>
      <p class="hero__text" data-hero>
        Payfuture provides business and enterprise payment solutions that help companies accept local payment methods,
        manage online payments, and support international and cross-border transactions across high-growth markets.
      </p>
      <div data-hero>
        <a class="btn btn--lg" href="#contact" data-magnetic>
          Get started
          <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
  </div>

  <div class="hero__media" data-hero-media>
    {
      heroSlides.map((slide, i) => (
        <div class="hero__slide">
          <img src={slide.src} alt={slide.alt} loading={i === 0 ? 'eager' : 'lazy'} width="1269" height="777" />
        </div>
      ))
    }
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="chip chip--approved" data-hero-chip aria-hidden="true">
      <span class="chip__icon"><Icon name="check" size={18} /></span>
      <span>
        <strong>Payment approved</strong>
        <small>UPI · INR 3,246</small>
      </span>
    </div>
    <div class="chip chip--methods" data-hero-chip aria-hidden="true">
      <span class="chip__flags">
        <img src="/img/flags/india.svg" alt="" />
        <img src="/img/flags/nigeria.svg" alt="" />
        <img src="/img/flags/egypt.svg" alt="" />
      </span>
      <span>
        <strong>Local payment methods</strong>
        <small>One API integration</small>
      </span>
    </div>

    <div class="hero__dots" role="tablist" aria-label="Hero images">
      {
        heroSlides.map((_, i) => (
          <button
            class={`hero__dot${i === 0 ? ' is-active' : ''}`}
            type="button"
            role="tab"
            aria-label={`Show image ${i + 1}`}
            aria-selected={i === 0 ? 'true' : 'false'}
          />
        ))
      }
    </div>
  </div>
</section>
