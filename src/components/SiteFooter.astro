---
import Icon from './Icon.astro';
import { footer } from '../data/site';
---

<footer class="footer">
  <div class="container">
    <!-- Subpages have no newsletter, so this block is their #contact target. -->
    <div class="footer__cta" id="get-started">
      <h2 data-split>Ready to <em>grow</em> in emerging markets?</h2>
      <div data-reveal>
        <a class="btn btn--lg" href="mailto:contact@payfuture.net" data-magnetic>
          Get started
          <span class="btn__arrow"><Icon name="arrow" size={16} /></span>
        </a>
      </div>
    </div>

    <div class="footer__main">
      {
        footer.columns.map((col) => (
          <div class={`footer__col${col.wide ? ' footer__col--wide' : ''}`} data-reveal>
            <h3>{col.title}</h3>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="footer__contact" data-reveal>
        <ul class="footer__socials">
          {
            footer.socials.map((s) => (
              <li>
                <a href="#" aria-label={s.name}>
                  <img src={s.icon} alt="" width="40" height="40" loading="lazy" />
                </a>
              </li>
            ))
          }
        </ul>
        <a class="footer__email" href={`mailto:${footer.email}`}>
          <img src="/img/icons/mail.svg" alt="" width="18" height="18" />
          {footer.email}
        </a>
      </div>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container">
      <ul>
        <li><a href="#">Privacy</a></li>
        <li><a href="#">Cookies</a></li>
        <li><a href="#">Terms and conditions</a></li>
      </ul>
      <p>© 2026 Payfuture Technologies LLC. All rights reserved.</p>
    </div>
  </div>
</footer>
