---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Bento from '../components/Bento.astro';
import GlobalReach from '../components/GlobalReach.astro';
import Story from '../components/Story.astro';
import Industries from '../components/Industries.astro';
import Challenges from '../components/Challenges.astro';
import Faq from '../components/Faq.astro';
import Newsletter from '../components/Newsletter.astro';
import { faqs, markets, reach } from '../data/home';
---

<Base
  title="Cross-border & stablecoin payments for emerging markets"
  description="Payfuture's multi-rail infrastructure connects cross-border and stablecoin payments to local methods across emerging markets. One integration, global reach."
  intro
  preload="/img/hero/dubai-treasury.webp"
>
  <Hero />
  <Bento />
  <GlobalReach title={reach.title} text={reach.text} markets={markets} />
  <Story />
  <Industries />
  <Challenges />
  <Faq items={faqs} />
  <Newsletter />
</Base>
