---
import Base from '../layouts/Base.astro';
import PageHero from '../components/page/PageHero.astro';
import ContactBlock from '../components/page/ContactBlock.astro';
import Newsletter from '../components/Newsletter.astro';
import { hero, newsletter } from '../data/contact';
---

<Base
  title="Contact | Payfuture"
  description="Get in touch with Payfuture. Tell us the corridor and the direction, and we’ll map it with you."
>
  <PageHero title={hero.title} text={hero.text} />
  <ContactBlock />
  <Newsletter id="newsletter" title={newsletter.title} text={newsletter.text} />
</Base>
