---
import '@fontsource-variable/montserrat';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import '../styles/pages.css';

import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  /** Homepage only: branded loader and the headline intro. */
  intro?: boolean;
  /** Preload the hero image so it is ready when the intro reveals it. */
  preload?: string;
  /** Social share image, as a site path or absolute URL. Defaults to a hero photo. */
  image?: string;
  /** Marks article pages for social cards. */
  type?: 'website' | 'article';
}
const { title, description, intro = false, preload, image = '/img/hero/dubai-treasury.webp', type = 'website' } = Astro.props;

// The demo is hidden from search engines. Set PUBLIC_INDEXABLE=true when the site goes live.
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Payfuture" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" type="image/png" href="/img/favicon.png" />
    {preload && <link rel="preload" as="image" href={preload} />}
    <script is:inline>
      // Hide intro elements until their animation runs; fall back to visible if the main script never loads.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('anim-ready');
        setTimeout(function () {
          if (!window.__pfReady) document.documentElement.classList.remove('anim-ready');
        }, 3500);
      }
    </script>
  </head>
  <body>
    <Header intro={intro} />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
